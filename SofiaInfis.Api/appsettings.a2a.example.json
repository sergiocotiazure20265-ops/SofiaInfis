{
  "A2A": {
    "Enabled": false,
    "AllowInsecureDevelopmentHttp": false,
    "DiscoveryTimeoutSeconds": 5,
    "CallTimeoutSeconds": 60,
    "ExecutionTimeoutSeconds": 120,
    "FinalizationTimeoutSeconds": 5,
    "PollingMilliseconds": 500,
    "MaxEnvelopeBytes": 1048576,
    "MaxActiveExecutions": 5,
    "MaxPendingExecutions": 10,
    "MaxConcurrentCalls": 3,
    "RetentionDays": 30,
    "MongoConnectionString": "mongodb://127.0.0.1:27029",
    "MongoDatabase": "sofia-a2a",
    "AllowedBrowserOrigins": [],
    "InboundClients": [
      {
        "ClientId": "infis-backend",
        "TokenHash": "REPLACE_WITH_64_HEX_SHA256_OF_EXTERNAL_TOKEN",
        "Permissions": ["a2a:agents:read", "a2a:execute", "a2a:read", "a2a:cancel"],
        "Capabilities": ["analisar_documentos"]
      }
    ],
    "Agents": [
      {
        "IdAgente": "agente-fiscal",
        "ExpectedName": "Agente Fiscal INFIS",
        "Enabled": true,
        "CardUri": "https://fiscal.example.invalid/.well-known/agent-card.json",
        "AllowedDestinations": [
          "https://fiscal.example.invalid/.well-known/agent-card.json",
          "https://fiscal.example.invalid/rpc"
        ],
        "AllowedAddresses": ["192.0.2.10"],
        "AllowedCapabilities": ["analisar_documentos"],
        "CredentialRef": "SOFIA_FISCAL_TOKEN",
        "DiscoveryCredentialRef": null
      }
    ]
  }
}
