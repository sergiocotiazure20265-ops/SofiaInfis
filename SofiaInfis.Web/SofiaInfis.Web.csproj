<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>sofia-infis-web-2026</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../SofiaInfis.Api/a2a-student-agents.json" Link="a2a-student-agents.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.example.json" CopyToPublishDirectory="Never" />
    <ProjectReference Include="../SofiaInfis.Api/SofiaInfis.Api.csproj" />
  </ItemGroup>

</Project>
